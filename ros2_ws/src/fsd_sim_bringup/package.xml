<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fsd_sim_bringup</name>
  <version>0.1.0</version>
  <description>Launch files, configuration, RViz layout and tracks for the FSG driverless simulator.</description>
  <maintainer email="driverless@example.com">FS Driverless Team</maintainer>
  <license>MIT</license>

  <exec_depend>fsdsim</exec_depend>
  <exec_depend>fsd_sim_bridge</exec_depend>
  <exec_depend>fsd_dashboard</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
